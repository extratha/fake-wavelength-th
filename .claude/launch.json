{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "socket-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:server"
      ],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set NEXT_PUBLIC_SOCKET_URL=http://localhost:4000&& npm run dev"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}